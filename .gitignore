# Python bytecode and tool caches (pipeline/ tests run with python -B in CI, but not everyone does locally)
__pycache__/
*.pyc
.pytest_cache/

# Pipeline outputs (`--out out/` in pipeline/README.md, run from the repo root or from pipeline/) hold prospect and verification data: never commit them.
/out/
/pipeline/out/
# Per-client deliveries (P4) and any other real-data folders: the CLIs refuse paths inside the checkout, this is the backstop.
deliveries/

# Client database files hold personal data and live outside the repository (see pipeline/CLIENT-DB-DESIGN.md).
# WAL mode leaves two sidecar files next to the database.
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db-wal
*.db-shm
